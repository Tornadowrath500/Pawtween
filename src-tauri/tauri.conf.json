{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pawtween",
  "version": "0.1.0",
  "identifier": "com.pawtween.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pawtween",
        "width": 1440,
        "height": 900,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "pawtween",
          "pawtweenpack"
        ],
        "name": "Pawtween project",
        "description": "Pawtween animation project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2M0I2RDhGNUI2M0Y0QzcKUldUSDlHTmJqMjA3ZGtOVGVFZENVUHdaWkhHdTIvTE8wSmkweU1XemVIYU5iYUpTZHgwb2x5SjIK",
      "endpoints": [
        "https://github.com/Tornadowrath500/Pawtween/releases/latest/download/latest.json"
      ]
    }
  }
}
